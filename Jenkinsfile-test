node('linux'){
withAWS(credentials:getAWSCredentialID(environment:"${env.APPENV}"), region:'us-east-1') {
	stage('Git Checkout'){
		checkout scm develop
	}

	stage('Check version') {
			sh 'npm --version && node --version'
	}
	stage('install') {
			sh 'npm install'
	}
	stage('migrate data seed') {
			sh 'sls dynamodb --migrate'
	}
	stage('deploy') {
			sh 'sls deploy'
	}
 }
  }
