library ('utils@master') _

def MAJOR_VERSION = "1"
def ARTIFACT_VERSION = "${MAJOR_VERSION}.${BUILD_NUMBER}"
//def  = "intl-latam-poliza-backend-jenks"
//def STACK_NAME_API = "intl-latam-poliza-apigateway-jenks"
node('linux'){

	stage('Git Checkout'){
		checkout scm develop
	}

	stage('Dev Deploy') {
		withAWS(credentials:getAWSCredentialID(environment:"${env.APPENV}"), region:'us-east-1') {
        
			sh """
				aws s3 mb s3://$BUCKET_NAME
				
				ls -ltr
				
				npm install	
				npm run-script build
					
				ls -ltr
				aws s3 cp build s3://$BUCKET_NAME  --recursive --acl public-read
				aws s3 website s3://$BUCKET_NAME/ --index-document index.html --error-document error.html
			"""
		}
	}
	stage('Completion Email'){
		    
	 mail to: '2ffc3f9d.LibertyMutual.onmicrosoft.com@amer.teams.ms', from: 'noreply-cdp@libertymutual.com',
                subject: "Dev Infra Deployment: ${env.JOB_NAME}", 
                body: "Despliegue realizado validar ambiente Dev en: http://poliza-express-hogar-front.s3-website-us-east-1.amazonaws.com/ Job Failed - \"${env.JOB_NAME}\" build: ${env.BUILD_NUMBER}\n\nView the log at:\n ${env.BUILD_URL}\n\nBlue Ocean:\n${env.RUN_DISPLAY_URL}"
	
	}
	stage('Test sonarqube'){
		withSonarQubeEnv('sonarqube') {
          	 sh 'sonar-scanner -Dsonar.projectKey=poliza-express-hogar-front -Dsonar.projectName=poliza-express-hogar-front -Dsonar.projectVersion=0.0.1 -Dsonar.sources=src'
	 }
	}
	stage('Testing'){
     withAWS(credentials:getAWSCredentialID(environment:"${env.APPENV}"), region:'us-east-1') {
        aws s3 mb s3://$BUCKET_NAME
		npm install jasmine-node --save-dev
		npm install request --save
	 }
	}
 }