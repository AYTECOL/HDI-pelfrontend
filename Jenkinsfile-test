node('linux'){

	stage('Git Checkout'){
		checkout scm develop
	}

	stage('Dev Deploy') {
		withAWS(credentials:getAWSCredentialID(environment:"${env.APPENV}"), region:'us-east-1') {
        	sh """
				aws s3 mb s3://$BUCKET_NAME				
				ls -ltr
				npm install	
				npm run-script build
				ls -ltr
				aws s3 cp build s3://$BUCKET_NAME  --recursive --acl public-read
				aws s3 website s3://$BUCKET_NAME/ --index-document index.html --error-document index.html
			"""
			"Resources" : {
            "myDistribution" : {
                "Type" : "AWS::CloudFront::Distribution",
                "Properties" : {
                    "DistributionConfig" : {
                        "Origins" : [ {
                            "DomainName" : "hogar-uat.libertyseguros.co",
                            "HTTPPort" : 80,
                            "HTTPSPort" : 443,
                            "OriginProtocolPolicy": "https-only"
                            "S3OriginConfig" : {
                              "OriginAccessIdentity": "origin-access-identity/cloudfront/libertyhome-dev-app",      
                            }
                        }],
                        "Enabled" : "true",
                        "Comment" : "Some comment",
                        "DefaultRootObject" : "index.html",
                        "Logging" : {
                            "IncludeCookies" : "false",
                            "Bucket" : "poliza-express-hogar-front"
                        },
                        "Aliases" : [ "hogar-uat.libertyseguros.co" , "hogar.libertyseguros.co"],
                        "DefaultCacheBehavior" : {
                            "AllowedMethods" : [ "DELETE", "GET", "OPTIONS", "POST", "PUT" ],  
                            "TargetOriginId" : "WebApp",
                            "ForwardedValues" : {
                                "QueryString" : "false",
                                "Cookies" : { "Forward" : "none" }
                            },
                            "ViewerProtocolPolicy" : "allow-all"
                        },
                      "PriceClass" : "PriceClass_200",
                      "ViewerCertificate" : { "CloudFrontDefaultCertificate" : "true" }  
                    }
                }
            }
        }
		}
	}

	stage('Completion Email'){
		    
	 mail to: '2ffc3f9d.LibertyMutual.onmicrosoft.com@amer.teams.ms', from: 'noreply-cdp@libertymutual.com',
                subject: "Dev Infra Deployment: ${env.JOB_NAME}", 
                body: "Despliegue realizado validar ambiente Dev en: http://poliza-express-hogar-front.s3-website-us-east-1.amazonaws.com/ Job Failed - \"${env.JOB_NAME}\" build: ${env.BUILD_NUMBER}\n\nView the log at:\n ${env.BUILD_URL}\n\nBlue Ocean:\n${env.RUN_DISPLAY_URL}"
	
	}
