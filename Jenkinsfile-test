node('linux'){

	stage('Git Checkout'){
		checkout scm develop
	}

	stage('Dev Deploy') {
		withAWS(credentials:getAWSCredentialID(environment:"${env.APPENV}"), region:'us-east-1') {
        
			sh """
				aws s3 mb s3://$BUCKET_NAME
				
				ls -ltr
				
				npm install	
				npm run-script build
					
				ls -ltr
				aws s3 cp build s3://$BUCKET_NAME  --recursive --acl public-read
			//	aws s3api put-bucket-website --bucket $BUCKET_NAME --website-configuration file://webSite.json
			"""

			deployToDev{
				stage('Git Checkout'){
					checkout scm
					sh """
						npm install
					"""
				}
			}
		}
	}
 }