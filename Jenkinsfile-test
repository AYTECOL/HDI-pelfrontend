node('linux'){

	stage('Git Checkout'){
		checkout scm develop
	}

	stage('Dev Deploy') {
		withAWS(credentials:getAWSCredentialID(environment:"${env.APPENV}"), region:'us-east-1') {
        
			sh """
				aws s3 mb s3://$BUCKET_NAME
				
				ls -ltr
				
				npm install	
				npm run-script build
					
				ls -ltr
				aws s3 cp build s3://$BUCKET_NAME  --recursive --acl public-read
				aws s3 website s3://$BUCKET_NAME/ --index-document index.html --error-document error.html
			"""
		}
	}
	stage('Completion Email'){

        mail bcc: '', body: ' Dev Infra Deployment completed successfully http://poliza-express-hogar-front.s3-website-us-east-1.amazonaws.com/.', cc: '', from: 'noreply-cdp@libertymutual.com', replyTo: '', subject: 'Dev Infra Deployment ', to: 'carlos.unate@libertycolombia.com'
		echo 'Dev Deploy complete http://poliza-express-hogar-front.s3-website-us-east-1.amazonaws.com/'
			
    }
	stage('Test sonarqube'){
		withSonarQubeEnv('sonarqube') {
          	 sh 'sonar-scanner -Dsonar.projectKey=poliza-express-hogar-front -Dsonar.projectName=poliza-express-hogar-front -Dsonar.projectVersion=0.0.1 -Dsonar.sources=src'
	 }
	}
	office365ConnectorWebhooks([[
		name: "Dev Deploy complete http://poliza-express-hogar-front.s3-website-us-east-1.amazonaws.com/", url: "https://outlook.office.com/webhook/749c14c8-f0a2-430e-8cdf-f3dbe55a26bb@08a83339-90e7-49bf-9075-957ccd561bf1/JenkinsCI/7f052cbefcdd4a82ba91952538c709db/c7749015-6707-40b2-bf1f-b9eb9a5c1d4a", notifyFailure: true
		]])

 }