{
  "name": "liberty-home-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "axios": "^1.11.0",
    "bootstrap": "^4.6.0",
    "clsx": "^1.1.1",
    "date-fns": "^1.30.1",
    "dotenv": "^17.2.1",
    "env-cmd": "10.1.0",
    "es6-promise": "^4.2.6",
    "es6-promise-promise": "^1.0.0",
    "google-map-react": "^2.1.10",
    "jquery": "^3.5.1",
    "moment": "^2.24.0",
    "prop-types": "^15.7.2",
    "react": "^16.8.4",
    "react-bootstrap": "^2.7.2",
    "react-bootstrap-icons": "^1.10.3",
    "react-datepicker": "^2.10.1",
    "react-dom": "^16.8.4",
    "react-hook-form": "^7.47.0",
    "react-redux": "^6.0.1",
    "react-router": "^4.3.1",
    "react-router-dom": "^4.3.1",
    "react-router-redux": "^4.0.8",
    "react-scripts": "^4.0.3",
    "redux": "^4.0.1",
    "redux-thunk": "^2.3.0",
    "sass": "^1.90.0",
    "serverless-plugin-resource-tagging": "^1.1.1",
    "simple-mask-money": "^3.0.1",
    "validator": "^13.15.15",
    "yup": "^1.3.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "CI=false && react-scripts build",
    "build:dev": "env-cmd -f env/dev.env npm run prebuild",
    "build:nonprod": "env-cmd -f env/nonprod.env npm run prebuild",
    "build:prod": "env-cmd -f env/prod.env npm run prebuild",
    "test": "react-scripts test --coverage --watchAll=false --coverageDirectory=coverage && npm run test:junit",
    "test:ci": "CI=true jest --ci --runInBand",
    "test:junit": "node scripts/test-junit.js",
    "test:watch": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false --coverageDirectory=coverage"
  },
  "jest": {
    "coverageReporters": [
      "text",
      "html",
      "json",
      "clover",
      "lcov"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/serviceWorker.js",
      "!src/**/*.test.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.js",
      "!<rootDir>/src/App.test.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(axios|date-fns|react-datepicker)/)"
    ],
    "moduleNameMapper": {
      "\\.(css|scss)$": "identity-obj-proxy"
    }
  },
  "jest-junit": {
    "outputDirectory": "./reports/junit",
    "outputName": "junit.xml",
    "suiteName": "Jest Tests",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  },
  "jestSonar": {
    "sonar56x": true,
    "reportPath": "coverage",
    "reportFile": "sonar-report.xml",
    "indent": 4
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "react-error-overlay": "6.0.9"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.0",
    "@silvermine/serverless-plugin-cloudfront-lambda-edge": "2.2.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.6.7",
    "cross-env": "^10.0.0",
    "enzyme": "^3.10.0",
    "enzyme-adapter-react-16": "^1.15.6",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "identity-obj-proxy": "^3.0.0",
    "jest-junit": "^16.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "prettier": "^2.7.1",
    "react-error-overlay": "6.0.9",
    "react-test-renderer": "^16.8.6",
    "redux-mock-store": "^1.5.5"
  }
}
