{
  "name": "liberty-home-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "axios": "^0.30.0",
    "bootstrap": "^4.6.0",
    "clsx": "^1.1.1",
    "date-fns": "^1.30.1",
    "dotenv": "^7.0.0",
    "env-cmd": "10.1.0",
    "es6-promise": "^4.2.6",
    "es6-promise-promise": "^1.0.0",
    "google-map-react": "^2.1.10",
    "jquery": "^3.5.1",
    "moment": "^2.24.0",
    "prop-types": "^15.7.2",
    "react": "^16.8.4",
    "react-bootstrap": "^2.7.2",
    "react-bootstrap-icons": "^1.10.3",
    "react-datepicker": "^2.10.1",
    "react-dom": "^16.8.4",
    "react-hook-form": "^7.47.0",
    "react-redux": "^6.0.1",
    "react-router": "^4.3.1",
    "react-router-dom": "^4.3.1",
    "react-router-redux": "^4.0.8",
    "react-scripts": "^4.0.3",
    "redux": "^4.0.1",
    "redux-thunk": "^2.3.0",
    "sass": "^1.64.2",
    "serverless-plugin-resource-tagging": "^1.1.1",
    "simple-mask-money": "^3.0.1",
    "validator": "^13.7.0",
    "yup": "^1.3.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "CI=false && react-scripts build",
    "build:dev": "env-cmd -f env/dev.env npm run prebuild",
    "build:nonprod": "env-cmd -f env/nonprod.env npm run prebuild",
    "build:prod": "env-cmd -f env/prod.env npm run prebuild",
    "test": "jest --config test/jest.config.js --coverage --ci --reporters=default --reporters=jest-junit"
  },
  "jest": {
    "coverageReporters": [
      "text",
      "html",
      "json",
      "clover",
      "lcov"
    ]
  },
  "jestSonar": {
    "sonar56x": true,
    "reportPath": "test/coverage",
    "reportFile": "clover.xml",
    "indent": 4
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "react-error-overlay": "6.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.0.0",
    "@babel/preset-react": "^7.0.0",
    "@silvermine/serverless-plugin-cloudfront-lambda-edge": "2.2.3",
    "@testing-library/dom": "^8.20.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "babel-cli": "^6.26.0",
    "babel-jest": "^26.6.0",
    "enzyme": "^3.10.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^26.6.0",
    "jest-environment-jsdom": "^26.6.0",
    "jest-junit": "^16.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "prettier": "^2.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-overlay": "6.0.9",
    "react-test-renderer": "^16.8.6"
  }
}
