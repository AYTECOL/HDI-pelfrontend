#!/usr/bin/env groovy
@Library('utils@master') _
import com.lmig.intl.cloud.jenkins.util.EnvConfigUtil
def ARTIFACT_VERSION = "1.${BUILD_NUMBER}";
node('linux') {
     stage('Preparation') {
      checkout scm
      sh 'pwd'
      sh 'ls'
   }
   stage('Zip Files && Artifactory upload') {
           sh 'cd ..'
           sh 'pwd'
           sh 'ls'
           sh 'zip -r pelhfrontend.zip . -x pelhfrontend/jenkins/dev_jenkinsfile pelhfrontend/jenkins/nonprod_jenkinsfile pelhfrontend/.serverless pelhfrontend/.git/**'
           sh 'pwd'
           sh 'ls'
			  def artifacts = ['pelhfrontend.zip']
		     artifactoryUploadFiles files:artifacts,version:ARTIFACT_VERSION,packageType:'npm',appName:'pelhfrontend'
   }
   stage('Artifactory Promoted to Prod') {
				promoteToProd(
					email:'Diana.HernandezL@Libertycolombia.com',
					promoteArtifact: true,
					appName:'pelhfrontend',
					packageType:'npm',
					version: ARTIFACT_VERSION,
					singleJenkinsfilePattern: true
				){}
		}
}
