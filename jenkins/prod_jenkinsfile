library ('utils@master') _

def MAJOR_VERSION = "1"
def ARTIFACT_VERSION = "${MAJOR_VERSION}.${BUILD_NUMBER}"
//def  = "intl-latam-poliza-backend-jenks"
//def STACK_NAME_API = "intl-latam-poliza-apigateway-jenks"
node('linux'){

	stage('Git Checkout'){
		checkout scm develop
	}    

    stage('cloudfront') {
        withAWS(credentials:getAWSCredentialID(environment:"${env.APPENV}"), region:'us-east-1') {
            sh "sls deploy -v --force"
            dir('dist/poliza-express-hogar'){
                sh 'pwd'
                sh 'ls'
            }
        }
    }

    stage('Build') {
         git credentialsId: 'intl_gituser', url: ' https://intl_gituser@bitbucket-latam.aws.lmig.com/scm/rt/pelhfrontend.git', branch: 'master'
         sh 'npm --version'
         sh 'aws --version'
         sh 'npm install'
         sh 'echo $PATH'
         sh 'sls --version'
         sh 'pwd'
         sh 'ls'
         sh 'dir'
    }
    
    stage('prod Deploy') {
        withAWS(credentials:getAWSCredentialID(environment:"${env.APPENV}"), region:'us-east-1') {
            sh """
                ls -ltr

                npm install
                npm run-script build
                ls -ltr
            """
            dir('build') {
                  sh 'pwd'
                  sh 'ls'
                  sh 'aws s3 rm s3://poliza-express-hogar --recursive' // Clean bucket
                  sh 'aws s3 sync .  s3://poliza-express-hogar' // Sync bucket
            }
        }
    }

    stage('Test sonarqube'){
		withSonarQubeEnv('sonarqube') {
        	sh 'sonar-scanner -Dsonar.projectKey=poliza-express-hogar-front -Dsonar.projectName=poliza-express-hogar-front -Dsonar.projectVersion=0.0.1 -Dsonar.sources=src'
	 	}
	}
 }
