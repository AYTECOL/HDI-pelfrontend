{
          "AWSTemplateFormatVersion": "2010-09-09",
          "Resources": {
            "libertyHogarDistribution": {
              "Type": "AWS::CloudFront::Distribution",
              "Properties": {
                "DistributionConfig": {
                  "Origins": [{
                      "Id": "polizaExpressHogarFront",
                      "DomainName": "arn:aws:s3:::poliza-express-hogar-front",
                      "S3OriginConfig": {
                        "OriginAccessIdentity": "origin-access-identity/cloudfront/libertyhome-dev-app"
                      }
                    },
                    {
                      "Id": "libertyseguros",
                      "DomainName": "hogar-uat.libertyseguros.co",
                      "CustomOriginConfig": {
                        "HTTPPort": "80",
                        "HTTPSPort": "443",
                        "OriginProtocolPolicy": "http-only"
                      }
                    }
                  ],
                  "Enabled": "true",
                  "Comment": "Some comment",
                  "DefaultRootObject": "index.html",
                  "Logging": {
                    "IncludeCookies": "false",
                    "Bucket": "poliza-express-hogar-front"
                  },
                  "Aliases": ["hogar-uat.libertyseguros.co", "hogar.libertyseguros.co"],
                  "DefaultCacheBehavior": {
                    "AllowedMethods": ["DELETE", "GET", "OPTIONS", "POST", "PUT"],
                    "TargetOriginId": "WebApp",
                    "ForwardedValues": {
                      "QueryString": "false",
                      "Cookies": {
                        "Forward": "none"
                      }
                    },
                    "ViewerProtocolPolicy": "allow-all"
                  },
                  "PriceClass": "PriceClass_200",
                  "ViewerCertificate": {
                    "CloudFrontDefaultCertificate": "true"
                  }
                }
              }
            }
          }
        }